    "@mikro-orm/postgresql": "^6.6.14",
    "@mikro-orm/reflection": "^6.6.14",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csvtojson": "^2.0.14",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-joi-validation": "^6.1.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
